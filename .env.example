# ==============================================================================
#  Sharad's Monthly & Intraday Option Selling Desk - Environment Configuration
# ==============================================================================

# Zerodha Kite Connect API Credentials
# Get your API key and Secret from https://developers.kite.trade
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here

# Automated Headless TOTP Login Credentials (Zero manual browser intervention)
# Enter your Zerodha web login credentials and the base32 TOTP secret from Google Authenticator
KITE_USER_ID=your_zerodha_user_id
KITE_PASSWORD=your_zerodha_password
KITE_TOTP_KEY=your_32_character_base32_totp_key

# Active Daily Access Token (Automatically updated by TOTP auto-login if configured)
KITE_ACCESS_TOKEN=your_daily_kite_access_token_here

# Telegram Notification Bot Configuration
# 1. Talk to @BotFather on Telegram to create a bot and get your BOT TOKEN.
# 2. Get your Chat ID by messaging @userinfobot or checking channel updates.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Execution Timezone & Fallbacks
TZ=Asia/Kolkata
USE_YFINANCE_FALLBACK=true

# 10:00 AM Intraday 4-OTM Desk Trading Mode (PAPER or LIVE)
# Sets whether the 10:00 AM option selling strategy runs in paper simulation or live execution
INTRADAY_OPTION_SELLING=PAPER
TRADE_LOTS=2
AUTO_TRADE=true
PRODUCT_TYPE=MIS

